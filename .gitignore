# cookies.txt is tracked as a blank placeholder so `docker compose` always has a file to mount.
# Never commit real cookies: after pasting them in, run
#   git update-index --skip-worktree cookies.txt
# so git ignores local changes to it (.gitignore can't do this for a tracked file).
